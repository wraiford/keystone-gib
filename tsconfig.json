{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "composite": true,
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "exclude": [
    "./dist",
    "**/*.respec.mts",
    "**/*.spec.mts"
  ]
}
